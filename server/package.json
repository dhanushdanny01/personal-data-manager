{
  "name": "personal-data-manager-server",
  "version": "2.0.0",
  "description": "Production-ready backend server for Personal Data Manager with advanced features",
  "main": "server.js",
  "scripts": {
    "start": "node enhancedServer.js",
    "dev": "nodemon enhancedServer.js",
    "prod": "NODE_ENV=production node enhancedServer.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "logs": "tail -f logs/combined.log",
    "health": "curl http://localhost:5002/health",
    "build": "echo 'No build step required for Node.js server'",
    "prestart": "npm run lint && npm run audit",
    "postinstall": "echo 'Post-install completed'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "rate-limiter-flexible": "^2.4.2",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "crud",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Personal Data Manager",
  "license": "MIT"
}
